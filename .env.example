# ============================================================
# CONFIGURAÇÕES DO BACKEND
# Localmente: copie este arquivo para ".env" (nesta pasta) e preencha.
# Na hospedagem (Render): cadastre estas variáveis no painel do serviço.
# NUNCA envie o arquivo ".env" para o GitHub nem para o chat.
# ============================================================

# --- Servidor ---
# A porta é definida automaticamente pela hospedagem; localmente use 3001
PORT=3001
# development (local) ou production (hospedagem)
NODE_ENV=development
# Endereço do frontend permitido a chamar esta API (sem barra no final).
# Local: http://localhost:5173
# Produção: https://SEU-SITE.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Supabase (painel do Supabase > Project Settings > API) ---
SUPABASE_URL=COLE_AQUI_A_URL_DO_SEU_PROJETO_SUPABASE
SUPABASE_ANON_KEY=COLE_AQUI_A_CHAVE_ANON

# --- IGDB (jogos) ---
# Credenciais do seu aplicativo em dev.twitch.tv/console
IGDB_CLIENT_ID=COLE_AQUI_O_CLIENT_ID_DA_TWITCH
IGDB_CLIENT_SECRET=COLE_AQUI_O_CLIENT_SECRET_DA_TWITCH

# --- Cinemeta (filmes e séries) e AniList (animes) ---
# Não precisam de chave.